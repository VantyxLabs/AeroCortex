# --- API ---
API_HOST=0.0.0.0
API_PORT=8001
API_KEY=change-me-local-dev-key

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=aerocortex

# --- Neo4j ---
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-local-dev-password

# --- Groq (REST API primary LLM) ---
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (Raspberry Pi / Groq-unreachable fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# --- Pinecone (REST API primary vector store) ---
PINECONE_ENABLED=true
PINECONE_API_KEY=
PINECONE_INDEX=aerocortex-episodes
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=64
# PINECONE_HOST=

# --- Chroma (Raspberry Pi / Pinecone-unreachable fallback) ---
CHROMA_DIR=data/knowledge/chroma

# --- Dashboard (Minimalist Monochrome SPA) ---
DASHBOARD_PORT=8501
# Browser-reachable AeroCortex API URL (dashboard proxies /api → this)
# Local: http://127.0.0.1:8001
# Render: https://aerocortex.onrender.com
DASHBOARD_API_URL=http://127.0.0.1:8001
