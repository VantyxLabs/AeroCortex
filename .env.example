# --- API ---
API_HOST=0.0.0.0
API_PORT=8001
API_KEY=change-me-local-dev-key

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=aerocortex

# --- Neo4j ---
NEO4J_ENABLED=true
NEO4J_URI=neo4j+s://93dda264.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-aura-password

# --- Groq (REST API primary LLM) ---
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Ollama (Raspberry Pi / Groq-unreachable fallback) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:latest

# --- Pinecone (REST API primary vector store) ---
PINECONE_ENABLED=true
PINECONE_API_KEY=
PINECONE_INDEX=aerocortex-episodes
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_DIMENSION=64
# PINECONE_HOST=

# --- Chroma (Raspberry Pi / Pinecone-unreachable fallback) ---
CHROMA_DIR=data/knowledge/chroma

# --- Dashboard (Minimalist Monochrome SPA) ---
DASHBOARD_PORT=8501
# Browser-reachable AeroCortex API URL (dashboard proxies /api → this)
# Local: http://127.0.0.1:8001
# Render: https://aerocortex.onrender.com
DASHBOARD_API_URL=http://127.0.0.1:8001

# --- AWS (optional; defaults preserve local behavior) ---
# MISSION_STORE=mongo
# WORKING_MEMORY_BACKEND=memory
# SIM_STATE_BACKEND=memory
# KNOWLEDGE_SNAPSHOT_BACKEND=file
# LEARNING_MODE=inline
# PLANNER_TIERS=groq,ollama,offline
# VECTOR_FALLBACK=chroma
# BEDROCK_MODEL_ID=
# BEDROCK_REGION=ap-south-1
# BEDROCK_TIMEOUT_S=8
# PLANNER_TOTAL_BUDGET_S=20
# MISSIONS_TABLE=
# STATE_TABLE=
# SNAPSHOT_BUCKET=
# SNAPSHOT_PREFIX=snapshots/
# EPISODE_QUEUE_URL=
# SSM_PREFIX=
# METRICS_ENABLED=false
# POWERTOOLS_METRICS_NAMESPACE=AeroCortex
# LAZY_RUNTIME=
#
# AWS profile example (set by SAM template):
# MISSION_STORE=dynamodb
# WORKING_MEMORY_BACKEND=dynamodb
# SIM_STATE_BACKEND=dynamodb
# KNOWLEDGE_SNAPSHOT_BACKEND=s3
# LEARNING_MODE=async
# PLANNER_TIERS=bedrock,groq,offline
# VECTOR_FALLBACK=none
# METRICS_ENABLED=true
# SSM_PREFIX=/aerocortex/prod
